# Pinned versions, in one place because up.sh installs them and prepull.sh has to pull the same ones.
# Reproducibility of every experiment depends on them; override in the environment to test a bump.
DATADOG_CHART_VERSION=${DATADOG_CHART_VERSION:-3.70.4}
CHAOS_MESH_VERSION=${CHAOS_MESH_VERSION:-2.6.3}
DEPLOY_JAEGER=${DEPLOY_JAEGER:-0}
