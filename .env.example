# Copy to .env and fill in. Never commit .env.
# Datadog site: the host part of your account URL (datadoghq.com, datadoghq.eu, us5.datadoghq.com, ...).
DD_SITE=datadoghq.eu

# API key: what the in-cluster Agent uses to ship metrics. A token cannot replace it.
DD_API_KEY=

# Service Access Token: what reads metrics and manages monitors. Scope it to exactly these six and
# nothing else (README step 2): timeseries_query, monitors_read, monitors_write, create_webhooks,
# dashboards_read, dashboards_write.
DD_ACCESS_TOKEN=

# Shared secret sent by the Datadog webhook as the X-RCA-Secret header.
WEBHOOK_SECRET=change-me

# rca-service
RCA_HOST=0.0.0.0
RCA_PORT=8000
RCA_RESULTS_DIR=results
RCA_PRISM_VARIANTS=prism,prismv2
# Printed by `make monitors`; reports deep-link to this dashboard when it is set.
RCA_DASHBOARD_ID=

# Optional: LLM summary of the ranking (report stays complete without it).
ANTHROPIC_API_KEY=
